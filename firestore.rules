rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Project: SAP Developer Shorts Studio
// Description: Verified episode blueprints, presentation variants,
//              neural speech & video production jobs, topic backlog,
//              news claim verifications, review workflow states,
//              custom avatars, speech auditions, and worker heartbeats.
//
// Collection: /episodes/{episodeId}
// Document ID: Pattern ^(ABAP|CAP|RAP|BTP|AI|NEWS)-[0-9]{2}$
// Fields:
//   - schemaVersion: int (required, == 1, immutable) - schema version
//   - id: string (required, matching episodeId, immutable) - unique episode identifier
//   - version: int (required, >= 1) - revision version number
//   - title: string (required, 1-120 chars) - episode title
//   - audience: string (required, 1-300 chars) - target developer audience
//   - language: string (required, 2-10 chars, e.g. 'en') - spoken language
//   - targetDurationSeconds: number (required, 30-120) - intended short duration
//   - environment: map (optional) - demo runtime setup and prerequisites
//   - sources: list (required, 1-25 items) - reference documentation sources
//   - claims: list (optional, 0-60 items) - key claims demonstrated or verified
//   - demo: map (optional) - demo project identifier and verification checks
//   - scenes: list (required, 1-30 items) - timeline scenes (narration, visuals, overlays)
//   - pronunciation: map (optional) - glossary for neural speech engine
//   - publication: map (required, channel & text <= 5000 chars) - social companion copy
//   - presentation: map (optional) - tone, format, humor, speaker voices
//   - format: string (optional, 1-30 chars) - content format (e.g. 'news')
//   - news: map (optional) - news event, asOf, maxAgeDays, editorialStatus
//   - status: string (optional, 'draft'|'reviewed'|'published'|'archived')
//   - published: bool (optional) - publication flag
//   - reviewStatus: string (optional, 'pending'|'in-review'|'reviewed'|'approved'|'rejected')
//   - createdAt: timestamp|string (optional)
//   - updatedAt: timestamp|string (optional)
//
// Collection: /episodes/{episodeId}/variants/{variantId}
// Document ID: Alphanumeric slug / variant name (e.g. 'casual', 'comic', 'quiz', 'casual-v2')
// Fields:
//   - schemaVersion: int (required, == 1, immutable) - schema version
//   - baseEpisodeId: string (required, matching parent episodeId, immutable)
//   - baseInputHash: string (required, 1-128 chars) - hash of parent episode blueprint
//   - title: string (required, 1-120 chars) - variant presentation title
//   - presentation: map (required, tone, format, humor, speakers 1-10)
//   - scenes: list (required, 1-50 items) - script narration & dialogue overrides
//   - publicationText: string (optional, 0-5000 chars) - custom publication draft
//   - pronunciation: map (optional) - voice glossary overrides
//   - createdAt: timestamp|string (optional)
//   - updatedAt: timestamp|string (optional)
//
// Collection: /productions/{jobId}
// Document ID: UUID string (production job ID)
// Fields:
//   - schemaVersion: int (required, == 1, immutable) - schema version
//   - id: string (optional, matching jobId) - job identifier
//   - selector: string (required, 3-80 chars, immutable) - episode or variant selector (e.g. 'CAP-01@casual-v2')
//   - stage: string (required, 'PENDING'|'PREFLIGHT'|'NARRATION'|'RENDER'|'LIBRARY'|'READY'|'BLOCKED'|'FAILED')
//   - progressMessage: string (optional, 0-1000 chars) - real-time worker progress description
//   - startedAt: timestamp|string (required) - job start time
//   - updatedAt: timestamp|string (required) - last heartbeat / update time
//   - error: string|null (optional, 0-2000 chars) - failure diagnostic message
//   - report: map (optional) - full ProductionReport payload from worker
//   - assets: map (optional) - download URLs for video, audio, captions, zip package
//   - mediaJobId: string|null (optional, 0-100 chars) - speech synthesis task ID
//   - inputHash: string|null (optional, 0-128 chars) - input content hash
//   - durationSeconds: number|null (optional, 0-600) - measured narration/video duration
//   - hookSeconds: number|null (optional, 0-30) - measured hook duration
//   - createdBy: string (optional, immutable) - user UID who requested production or 'studio-browser'
//   - failedAt: string|null (optional, 'PREFLIGHT'|'NARRATION'|'RENDER'|'LIBRARY')
//   - issue: map|null (optional) - structured blocking issue details
//   - definition: map (optional) - inline draft definition submitted with produce request
//   - workerId: string (optional, 1-120 chars) - identifier of the executing Mac render worker
//
// Collection: /topics/{topicId}
// Document ID: Pattern ^(ABAP|CAP|RAP|BTP|AI)-[0-9]{2}$
// Fields:
//   - id: string (required, matching topicId, immutable)
//   - pillar: string (required, 'ABAP'|'CAP'|'RAP'|'BTP'|'AI', immutable)
//   - title: string (required, 1-200 chars) - topic title
//   - status: string (required, 'needs-research'|'pilot-ready')
//   - prerequisites: list (required, 0-50 items) - developer setup requirements
//   - sources: list (optional, 0-25 items) - reference documentation
//   - supportedRelease: string|null (optional, 0-100 chars) - release baseline
//   - verifiedOn: string|timestamp|null (optional) - verification date
//   - outcome: string (required, 1-1000 chars) - expected demo payoff
//   - createdAt: timestamp|string (optional)
//   - updatedAt: timestamp|string (optional)
//
// Collection: /news/{newsId}
// Document ID: Pattern ^NEWS-[0-9]{2}$
// Fields:
//   - id: string (required, matching newsId, immutable)
//   - title: string (required, 1-200 chars) - news short headline
//   - event: string (required, 1-200 chars) - event origin (e.g. 'SAP Connect 2026')
//   - angle: string (optional, 0-500 chars) - editorial focus angle
//   - priority: int (optional, 1-100) - queue priority
//   - status: string (optional, 'draft-ready'|'needs-research'|'verified'|'published'|'archived')
//   - sources: list (optional, 0-30 items) - official SAP news sources
//   - sourceUrls: list (optional, 0-30 items) - external source URIs
//   - claims: list (optional, 0-50 items) - verified announcement claims
//   - claimReviews: list (optional, 0-50 items) - dated claim reviews
//   - validThrough: string|timestamp (optional) - claim validity cutoff
//   - asOf: string|timestamp (optional) - source check date
//   - editorialStatus: string (optional, 0-50 chars)
//   - createdAt: timestamp|string (optional)
//   - updatedAt: timestamp|string (optional)
//
// Collection: /workflow/{recordId}
// Document ID: Selector or workflow slug (e.g. 'CAP-01--casual-v2')
// Fields:
//   - selector: string (required, 3-80 chars) - episode/variant selector
//   - renderKey: string (required, 1-128 chars) - rendering cache key
//   - inputHash: string (required, 1-128 chars) - blueprint input hash
//   - videoHash: string (required, 1-128 chars) - generated video SHA-256 hash
//   - reviewedAt: timestamp|string (optional) - review approval date
//   - publication: map (optional) - publication metadata
//   - stage: string (optional, 1-50 chars) - workflow review state
//   - label: string (optional, 1-200 chars) - display label
//   - updatedAt: timestamp|string (optional)
//   - assets: map (optional) - output assets (urls, sizes, formats)
//
// Collection: /avatars/{imageId}
// Document ID: Speaker portrait image ID
// Fields:
//   - imageId: string (required, matching imageId, 1-100 chars)
//   - sha256: string (required, 1-128 chars) - image content SHA-256
//   - url: string (optional, 1-2048 chars) - storage download URL
//   - storagePath: string (optional, 1-500 chars) - Cloud Storage object path
//   - dataUrl: string (optional, up to 1048576 chars / 1 MiB) - base64 preview data URL
//   - createdAt: timestamp|string (optional)
//   - updatedAt: timestamp|string (optional)
//
// Collection: /auditions/{auditionId}
// Document ID: UUID string or audition identifier
// Fields:
//   - id: string (required, matching auditionId, 1-100 chars)
//   - text: string (required, 1-1000 chars) - input audition phrase text
//   - voice: string (required, 1-64 chars) - neural voice identifier
//   - speed: number (optional, 0.5-2.5) - speech tempo rate
//   - pronunciation: map (optional) - pronunciation overrides
//   - status: string (required, 'PENDING'|'SYNTHESIZING'|'READY'|'FAILED')
//   - spokenText: string (optional, 1-1500 chars) - normalized spoken text
//   - durationSeconds: number|null (optional, 0-120) - measured duration
//   - audioDataUrl: string (optional, up to 1048576 chars / 1 MiB) - preview base64 audio
//   - audioUrl: string (optional, 1-2048 chars) - storage audio URL
//   - error: string|null (optional, 0-2000 chars) - error message if failed
//   - createdAt: timestamp|string (optional)
//   - updatedAt: timestamp|string (optional)
//
// Collection: /workers/{workerId}
// Document ID: Unique worker identifier (e.g. hostname or UUID)
// Fields:
//   - workerId: string (required, matching workerId, 1-120 chars)
//   - hostname: string (required, 1-120 chars) - machine hostname
//   - arch: string (optional, 1-30 chars) - CPU architecture (e.g. 'arm64')
//   - status: string (required, 'ONLINE'|'BUSY'|'IDLE'|'OFFLINE')
//   - activeJobId: string|null (optional, 1-100 chars) - currently executing job
//   - portraitRuntime: map (optional) - avatar/portrait engine capabilities
//   - voices: list (optional, 0-100 items) - installed Kokoro neural voices
//   - lastHeartbeatAt: timestamp|string (required) - last heartbeat ping
//   - updatedAt: timestamp|string (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Helper Functions
    // ===============================================================

    // Check if the request is authenticated (including Firebase Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user has an authorized Editor or Admin role
    // Authority is derived from trusted custom claims or verified bootstrap email domain
    function isEditor() {
      return isAuthenticated() &&
        (
          ('role' in request.auth.token && (request.auth.token.role == 'editor' || request.auth.token.role == 'admin')) ||
          ('editor' in request.auth.token && request.auth.token.editor == true) ||
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('email' in request.auth.token &&
           'email_verified' in request.auth.token &&
           request.auth.token.email_verified == true &&
           request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@sap\\.com$'))
        );
    }

    // Validate presence of all mandatory fields
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Enforce strict schema with no extraneous fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate string within length boundaries
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate optional timestamp or ISO date string (YYYY-MM-DD or ISO 8601)
    function isValidOptionalTimestampOrDate(data, field) {
      return !(field in data) ||
        data[field] is timestamp ||
        (data[field] is string && data[field].size() >= 10 && data[field].size() <= 40);
    }

    // ===============================================================
    // 1. /episodes/{episodeId}
    // ===============================================================

    function isValidEpisode(data, episodeId) {
      return hasRequiredFields(data, [
               'schemaVersion', 'id', 'version', 'title', 'audience',
               'language', 'targetDurationSeconds', 'sources', 'scenes', 'publication'
             ]) &&
             hasOnlyAllowedFields(data, [
               'schemaVersion', 'id', 'version', 'title', 'audience',
               'language', 'targetDurationSeconds', 'environment', 'sources',
               'claims', 'demo', 'scenes', 'pronunciation', 'publication',
               'presentation', 'format', 'news', 'status', 'published',
               'reviewStatus', 'createdAt', 'updatedAt'
             ]) &&
             data.schemaVersion == 1 &&
             data.id == episodeId &&
             episodeId.matches('^(ABAP|CAP|RAP|BTP|AI|NEWS)-[0-9]{2}$') &&
             data.version is int && data.version >= 1 &&
             isValidString(data.title, 1, 120) &&
             isValidString(data.audience, 1, 300) &&
             isValidString(data.language, 2, 10) &&
             data.targetDurationSeconds is number &&
             data.targetDurationSeconds >= 30 && data.targetDurationSeconds <= 120 &&
             data.sources is list && data.sources.size() >= 1 && data.sources.size() <= 25 &&
             data.scenes is list && data.scenes.size() >= 1 && data.scenes.size() <= 30 &&
             data.publication is map &&
             data.publication.keys().hasAll(['channel', 'text']) &&
             isValidString(data.publication.channel, 1, 50) &&
             isValidString(data.publication.text, 1, 5000) &&
             (!('claims' in data) || (data.claims is list && data.claims.size() <= 60)) &&
             (!('environment' in data) || data.environment is map) &&
             (!('demo' in data) || data.demo is map) &&
             (!('pronunciation' in data) || data.pronunciation is map) &&
             (!('presentation' in data) || data.presentation is map) &&
             (!('format' in data) || isValidString(data.format, 1, 30)) &&
             (!('news' in data) || data.news is map) &&
             (!('status' in data) || (data.status is string && data.status in ['draft', 'reviewed', 'published', 'archived'])) &&
             (!('published' in data) || data.published is bool) &&
             (!('reviewStatus' in data) || (data.reviewStatus is string && data.reviewStatus in ['pending', 'in-review', 'reviewed', 'approved', 'rejected'])) &&
             isValidOptionalTimestampOrDate(data, 'createdAt') &&
             isValidOptionalTimestampOrDate(data, 'updatedAt');
    }

    function areEpisodeImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schemaVersion', 'id']);
    }

    match /episodes/{episodeId} {
      allow read: if true;
      allow create: if isEditor() && isValidEpisode(request.resource.data, episodeId);
      allow update: if isEditor() && isValidEpisode(request.resource.data, episodeId) &&
                       areEpisodeImmutableFieldsUnchanged();
      allow delete: if isEditor();

      // =============================================================
      // 2. /episodes/{episodeId}/variants/{variantId}
      // =============================================================

      function isValidVariant(data, expectedEpisodeId, expectedVariantId) {
        return hasRequiredFields(data, [
                 'schemaVersion', 'baseEpisodeId', 'baseInputHash', 'title', 'presentation', 'scenes'
               ]) &&
               hasOnlyAllowedFields(data, [
                 'schemaVersion', 'baseEpisodeId', 'baseInputHash', 'title',
                 'presentation', 'scenes', 'publicationText', 'pronunciation',
                 'createdAt', 'updatedAt'
               ]) &&
               data.schemaVersion == 1 &&
               data.baseEpisodeId == expectedEpisodeId &&
               isValidString(data.baseInputHash, 1, 128) &&
               isValidString(data.title, 1, 120) &&
               data.presentation is map &&
               data.presentation.keys().hasAll(['tone', 'format', 'humor', 'speakers']) &&
               data.presentation.tone in ['professional', 'casual', 'comic'] &&
               data.presentation.format in ['explainer', 'dialogue', 'myth-fact', 'countdown', 'story', 'quiz'] &&
               data.presentation.humor in ['none', 'light', 'sap-geek'] &&
               data.presentation.speakers is list &&
               data.presentation.speakers.size() >= 1 && data.presentation.speakers.size() <= 10 &&
               (!('variant' in data.presentation) || (data.presentation.variant is string && data.presentation.variant == expectedVariantId)) &&
               data.scenes is list && data.scenes.size() >= 1 && data.scenes.size() <= 50 &&
               (!('publicationText' in data) || isValidString(data.publicationText, 0, 5000)) &&
               (!('pronunciation' in data) || data.pronunciation is map) &&
               isValidOptionalTimestampOrDate(data, 'createdAt') &&
               isValidOptionalTimestampOrDate(data, 'updatedAt');
      }

      function areVariantImmutableFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schemaVersion', 'baseEpisodeId']);
      }

      match /variants/{variantId} {
        allow read: if true;
        allow create: if isEditor() && isValidVariant(request.resource.data, episodeId, variantId);
        allow update: if isEditor() && isValidVariant(request.resource.data, episodeId, variantId) &&
                         areVariantImmutableFieldsUnchanged();
        allow delete: if isEditor();
      }
    }

    // ===============================================================
    // 3. /productions/{jobId}
    // ===============================================================

    function isValidProductionJob(data, jobId) {
      return hasRequiredFields(data, ['schemaVersion', 'selector', 'stage', 'startedAt', 'updatedAt']) &&
             hasOnlyAllowedFields(data, [
               'schemaVersion', 'id', 'selector', 'stage', 'progressMessage',
               'startedAt', 'updatedAt', 'error', 'report', 'assets',
               'mediaJobId', 'inputHash', 'durationSeconds', 'hookSeconds',
               'createdBy', 'failedAt', 'issue', 'definition', 'workerId'
             ]) &&
             data.schemaVersion == 1 &&
             isValidString(data.selector, 3, 80) &&
             data.selector.matches('^(ABAP|CAP|RAP|BTP|AI|NEWS)-[0-9]{2}(@[a-z0-9-]+)?$') &&
             data.stage in ['PENDING', 'PREFLIGHT', 'NARRATION', 'RENDER', 'LIBRARY', 'READY', 'BLOCKED', 'FAILED'] &&
             (data.startedAt is timestamp || (data.startedAt is string && data.startedAt.size() >= 10 && data.startedAt.size() <= 40)) &&
             (data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40)) &&
             (!('id' in data) || (data.id is string && data.id == jobId && data.id.size() <= 100)) &&
             (!('progressMessage' in data) || isValidString(data.progressMessage, 0, 1000)) &&
             (!('error' in data) || data.error == null || isValidString(data.error, 0, 2000)) &&
             (!('report' in data) || data.report is map) &&
             (!('assets' in data) || data.assets is map) &&
             (!('mediaJobId' in data) || data.mediaJobId == null || isValidString(data.mediaJobId, 1, 100)) &&
             (!('inputHash' in data) || data.inputHash == null || isValidString(data.inputHash, 1, 128)) &&
             (!('durationSeconds' in data) || data.durationSeconds == null || (data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 600)) &&
             (!('hookSeconds' in data) || data.hookSeconds == null || (data.hookSeconds is number && data.hookSeconds >= 0 && data.hookSeconds <= 30)) &&
             (!('createdBy' in data) || isValidString(data.createdBy, 1, 128)) &&
             (!('failedAt' in data) || data.failedAt == null || (data.failedAt is string && data.failedAt in ['PREFLIGHT', 'NARRATION', 'RENDER', 'LIBRARY'])) &&
             (!('issue' in data) || data.issue == null || data.issue is map) &&
             (!('definition' in data) || data.definition is map) &&
             (!('workerId' in data) || isValidString(data.workerId, 1, 120));
    }

    function isValidStageTransition(prevStage, newStage) {
      return prevStage == newStage ||
        newStage in ['BLOCKED', 'FAILED'] ||
        (prevStage in ['BLOCKED', 'FAILED', 'READY'] && newStage in ['PENDING', 'PREFLIGHT']) ||
        (prevStage == 'PENDING' && newStage in ['PREFLIGHT', 'NARRATION', 'RENDER', 'LIBRARY', 'READY']) ||
        (prevStage == 'PREFLIGHT' && newStage in ['NARRATION', 'RENDER', 'LIBRARY', 'READY']) ||
        (prevStage == 'NARRATION' && newStage in ['RENDER', 'LIBRARY', 'READY']) ||
        (prevStage == 'RENDER' && newStage in ['LIBRARY', 'READY']) ||
        (prevStage == 'LIBRARY' && newStage == 'READY');
    }

    function areProductionImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schemaVersion', 'selector', 'createdBy']) &&
        (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id);
    }

    match /productions/{jobId} {
      allow read: if true;
      allow create: if isEditor() &&
                       isValidProductionJob(request.resource.data, jobId) &&
                       request.resource.data.stage in ['PENDING', 'PREFLIGHT'] &&
                       (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid);
      allow update: if isEditor() &&
                       isValidProductionJob(request.resource.data, jobId) &&
                       areProductionImmutableFieldsUnchanged() &&
                       isValidStageTransition(resource.data.stage, request.resource.data.stage);
      allow delete: if isEditor();
    }

    // ===============================================================
    // 4. /topics/{topicId}
    // ===============================================================

    function isValidTopic(data, topicId) {
      return hasRequiredFields(data, ['id', 'pillar', 'title', 'status', 'prerequisites', 'outcome']) &&
             hasOnlyAllowedFields(data, [
               'id', 'pillar', 'title', 'status', 'prerequisites',
               'sources', 'supportedRelease', 'verifiedOn', 'outcome',
               'createdAt', 'updatedAt'
             ]) &&
             data.id == topicId &&
             topicId.matches('^(ABAP|CAP|RAP|BTP|AI)-[0-9]{2}$') &&
             data.pillar in ['ABAP', 'CAP', 'RAP', 'BTP', 'AI'] &&
             isValidString(data.title, 1, 200) &&
             data.status in ['needs-research', 'pilot-ready'] &&
             data.prerequisites is list && data.prerequisites.size() <= 50 &&
             (!('sources' in data) || (data.sources is list && data.sources.size() <= 25)) &&
             (!('supportedRelease' in data) || data.supportedRelease == null || isValidString(data.supportedRelease, 1, 100)) &&
             (!('verifiedOn' in data) || data.verifiedOn == null || data.verifiedOn is timestamp || (data.verifiedOn is string && data.verifiedOn.size() >= 10 && data.verifiedOn.size() <= 40)) &&
             isValidString(data.outcome, 1, 1000) &&
             isValidOptionalTimestampOrDate(data, 'createdAt') &&
             isValidOptionalTimestampOrDate(data, 'updatedAt');
    }

    function areTopicImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'pillar']);
    }

    match /topics/{topicId} {
      allow read: if true;
      allow create: if isEditor() && isValidTopic(request.resource.data, topicId);
      allow update: if isEditor() && isValidTopic(request.resource.data, topicId) &&
                       areTopicImmutableFieldsUnchanged();
      allow delete: if isEditor();
    }

    // ===============================================================
    // 5. /news/{newsId}
    // ===============================================================

    function isValidNews(data, newsId) {
      return hasRequiredFields(data, ['id', 'title', 'event']) &&
             hasOnlyAllowedFields(data, [
               'id', 'title', 'event', 'angle', 'priority', 'status',
               'sources', 'sourceUrls', 'claims', 'claimReviews',
               'validThrough', 'asOf', 'editorialStatus', 'createdAt', 'updatedAt'
             ]) &&
             data.id == newsId &&
             newsId.matches('^NEWS-[0-9]{2}$') &&
             isValidString(data.title, 1, 200) &&
             isValidString(data.event, 1, 200) &&
             (!('angle' in data) || isValidString(data.angle, 0, 500)) &&
             (!('priority' in data) || (data.priority is int && data.priority >= 1 && data.priority <= 100)) &&
             (!('status' in data) || (data.status is string && data.status in ['draft-ready', 'needs-research', 'verified', 'published', 'archived'])) &&
             (!('sources' in data) || (data.sources is list && data.sources.size() <= 30)) &&
             (!('sourceUrls' in data) || (data.sourceUrls is list && data.sourceUrls.size() <= 30)) &&
             (!('claims' in data) || (data.claims is list && data.claims.size() <= 50)) &&
             (!('claimReviews' in data) || (data.claimReviews is list && data.claimReviews.size() <= 50)) &&
             isValidOptionalTimestampOrDate(data, 'validThrough') &&
             isValidOptionalTimestampOrDate(data, 'asOf') &&
             (!('editorialStatus' in data) || isValidString(data.editorialStatus, 0, 50)) &&
             isValidOptionalTimestampOrDate(data, 'createdAt') &&
             isValidOptionalTimestampOrDate(data, 'updatedAt');
    }

    function areNewsImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']);
    }

    match /news/{newsId} {
      allow read: if true;
      allow create: if isEditor() && isValidNews(request.resource.data, newsId);
      allow update: if isEditor() && isValidNews(request.resource.data, newsId) &&
                       areNewsImmutableFieldsUnchanged();
      allow delete: if isEditor();
    }

    // ===============================================================
    // 6. /workflow/{recordId}
    // ===============================================================

    function isValidWorkflowRecord(data) {
      return hasRequiredFields(data, ['selector', 'renderKey', 'inputHash', 'videoHash']) &&
             hasOnlyAllowedFields(data, [
               'selector', 'renderKey', 'inputHash', 'videoHash',
               'reviewedAt', 'publication', 'stage', 'label', 'updatedAt', 'assets'
             ]) &&
             isValidString(data.selector, 3, 80) &&
             data.selector.matches('^(ABAP|CAP|RAP|BTP|AI|NEWS)-[0-9]{2}(@[a-z0-9-]+)?$') &&
             isValidString(data.renderKey, 1, 128) &&
             isValidString(data.inputHash, 1, 128) &&
             isValidString(data.videoHash, 1, 128) &&
             isValidOptionalTimestampOrDate(data, 'reviewedAt') &&
             (!('publication' in data) || data.publication is map) &&
             (!('stage' in data) || isValidString(data.stage, 1, 50)) &&
             (!('label' in data) || isValidString(data.label, 1, 200)) &&
             (!('assets' in data) || data.assets is map) &&
             isValidOptionalTimestampOrDate(data, 'updatedAt');
    }

    function areWorkflowImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['selector', 'renderKey']);
    }

    match /workflow/{recordId} {
      allow read: if true;
      allow create: if isEditor() && isValidWorkflowRecord(request.resource.data);
      allow update: if isEditor() && isValidWorkflowRecord(request.resource.data) &&
                       areWorkflowImmutableFieldsUnchanged();
      allow delete: if isEditor();
    }

    // ===============================================================
    // 7. /avatars/{imageId}
    // ===============================================================

    function isValidAvatarDoc(data, imageId) {
      return hasRequiredFields(data, ['imageId', 'sha256']) &&
             hasOnlyAllowedFields(data, [
               'imageId', 'sha256', 'url', 'storagePath', 'dataUrl', 'updatedAt', 'createdAt'
             ]) &&
             data.imageId == imageId &&
             isValidString(data.imageId, 1, 100) &&
             isValidString(data.sha256, 1, 128) &&
             (!('url' in data) || isValidString(data.url, 1, 2048)) &&
             (!('storagePath' in data) || isValidString(data.storagePath, 1, 500)) &&
             (!('dataUrl' in data) || isValidString(data.dataUrl, 1, 1048576)) &&
             isValidOptionalTimestampOrDate(data, 'createdAt') &&
             isValidOptionalTimestampOrDate(data, 'updatedAt');
    }

    function areAvatarImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['imageId']);
    }

    match /avatars/{imageId} {
      allow read: if true;
      allow create: if isEditor() && isValidAvatarDoc(request.resource.data, imageId);
      allow update: if isEditor() && isValidAvatarDoc(request.resource.data, imageId) &&
                       areAvatarImmutableFieldsUnchanged();
      allow delete: if isEditor();
    }

    // ===============================================================
    // 8. /auditions/{auditionId}
    // ===============================================================

    function isValidAuditionDoc(data, auditionId) {
      return hasRequiredFields(data, ['id', 'text', 'voice', 'status']) &&
             hasOnlyAllowedFields(data, [
               'id', 'text', 'voice', 'speed', 'pronunciation', 'status',
               'spokenText', 'durationSeconds', 'audioDataUrl', 'audioUrl',
               'error', 'createdAt', 'updatedAt'
             ]) &&
             data.id == auditionId &&
             isValidString(data.id, 1, 100) &&
             isValidString(data.text, 1, 1000) &&
             isValidString(data.voice, 1, 64) &&
             data.status in ['PENDING', 'SYNTHESIZING', 'READY', 'FAILED'] &&
             (!('speed' in data) || (data.speed is number && data.speed >= 0.5 && data.speed <= 2.5)) &&
             (!('pronunciation' in data) || data.pronunciation is map) &&
             (!('spokenText' in data) || isValidString(data.spokenText, 1, 1500)) &&
             (!('durationSeconds' in data) || data.durationSeconds == null || (data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 120)) &&
             (!('audioDataUrl' in data) || isValidString(data.audioDataUrl, 1, 1048576)) &&
             (!('audioUrl' in data) || isValidString(data.audioUrl, 1, 2048)) &&
             (!('error' in data) || data.error == null || isValidString(data.error, 0, 2000)) &&
             isValidOptionalTimestampOrDate(data, 'createdAt') &&
             isValidOptionalTimestampOrDate(data, 'updatedAt');
    }

    function areAuditionImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']);
    }

    match /auditions/{auditionId} {
      allow read: if true;
      allow create: if isEditor() && isValidAuditionDoc(request.resource.data, auditionId);
      allow update: if isEditor() && isValidAuditionDoc(request.resource.data, auditionId) &&
                       areAuditionImmutableFieldsUnchanged();
      allow delete: if isEditor();
    }

    // ===============================================================
    // 9. /workers/{workerId}
    // ===============================================================

    function isValidWorkerDoc(data, workerId) {
      return hasRequiredFields(data, ['workerId', 'hostname', 'status', 'lastHeartbeatAt']) &&
             hasOnlyAllowedFields(data, [
               'workerId', 'hostname', 'arch', 'status', 'activeJobId',
               'portraitRuntime', 'voices', 'lastHeartbeatAt', 'updatedAt'
             ]) &&
             data.workerId == workerId &&
             isValidString(data.workerId, 1, 120) &&
             isValidString(data.hostname, 1, 120) &&
             data.status in ['ONLINE', 'BUSY', 'IDLE', 'OFFLINE'] &&
             (data.lastHeartbeatAt is timestamp || (data.lastHeartbeatAt is string && data.lastHeartbeatAt.size() >= 10 && data.lastHeartbeatAt.size() <= 40)) &&
             (!('arch' in data) || isValidString(data.arch, 1, 30)) &&
             (!('activeJobId' in data) || data.activeJobId == null || isValidString(data.activeJobId, 1, 100)) &&
             (!('portraitRuntime' in data) || data.portraitRuntime is map) &&
             (!('voices' in data) || (data.voices is list && data.voices.size() <= 100)) &&
             isValidOptionalTimestampOrDate(data, 'updatedAt');
    }

    match /workers/{workerId} {
      allow read: if true;
      allow create, update: if isEditor() && isValidWorkerDoc(request.resource.data, workerId);
      allow delete: if isEditor();
    }

    // ===============================================================
    // Default Deny Root
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
