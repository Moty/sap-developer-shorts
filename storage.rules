rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public access to exported short media and review packages
    match /episodes/{selector}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Voice audition sample audio
    match /voices/{voiceId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Custom speaker portrait images (normalized 512x512 PNGs)
    match /avatars/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // On-demand phrase audition WAV files
    match /auditions/{auditionId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Default deny for unauthenticated writes
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
