rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public access to exported short media and review packages
    match /episodes/{selector}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Voice audition sample audio
    match /voices/{voiceId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for unauthenticated writes
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
