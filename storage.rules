rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isEditor() {
      return request.auth != null &&
        (
          ('role' in request.auth.token && (request.auth.token.role == 'editor' || request.auth.token.role == 'admin')) ||
          ('editor' in request.auth.token && request.auth.token.editor == true) ||
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('email' in request.auth.token &&
           'email_verified' in request.auth.token &&
           request.auth.token.email_verified == true &&
           request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@sap\\.com$'))
        );
    }

    // Public access to exported short media and review packages
    match /episodes/{selector}/{allPaths=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Voice audition sample audio
    match /voices/{voiceId}/{allPaths=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Custom speaker portrait images (normalized 512x512 PNGs)
    match /avatars/{imageId} {
      allow read: if true;
      allow create, update: if isEditor()
                            && request.resource.size <= 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isEditor();
    }

    // On-demand phrase audition WAV files
    match /auditions/{auditionId} {
      allow read: if true;
      allow create, update: if isEditor()
                            && request.resource.size <= 10 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if isEditor();
    }

    // Unrecognized paths remain unavailable, including to signed-in users.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
