FROM node:22.13.0-bookworm-slim AS build
WORKDIR /app
COPY package*.json tsconfig.json ./
COPY demos/cap/inventory/package.json demos/cap/inventory/package.json
RUN npm ci --include=dev
COPY src src
COPY scripts scripts
COPY schemas schemas
COPY config config
COPY templates templates
COPY content content
COPY assets assets
COPY demos demos
RUN mkdir -p content/presentations assets/avatars && cp config/private-templates/*.json content/presentations/
RUN npm run build && npm run private:build

FROM node:22.13.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
COPY demos/cap/inventory/package.json demos/cap/inventory/package.json
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build --chown=node:node /app/dist/src dist/src
COPY --from=build --chown=node:node /app/dist/private-studio dist/private-studio
COPY --from=build --chown=node:node /app/src src
COPY --from=build --chown=node:node /app/scripts scripts
COPY --from=build --chown=node:node /app/schemas schemas
COPY --from=build --chown=node:node /app/config config
COPY --from=build --chown=node:node /app/templates templates
COPY --from=build --chown=node:node /app/content content
COPY --from=build --chown=node:node /app/assets assets
COPY --from=build --chown=node:node /app/demos demos
ENV NODE_ENV=production
USER node
EXPOSE 8080
CMD ["node", "dist/src/cloud/server.js"]
