{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        }
      },
      "required": ["width", "height"]
    },
    "criticalContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["x", "y", "width", "height"]
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fontSize": {
          "type": "integer",
          "minimum": 44
        }
      },
      "required": ["x", "y", "width", "height", "fontSize"]
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fontSize": {
          "type": "integer",
          "minimum": 44
        }
      },
      "required": ["x", "y", "width", "height", "fontSize"]
    },
    "presenter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["x", "y", "width", "height"]
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fontSize": {
          "type": "integer",
          "minimum": 44
        }
      },
      "required": ["x", "y", "width", "height", "fontSize"]
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "canvas",
    "criticalContent",
    "headline",
    "demo",
    "presenter",
    "captions",
    "note"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vertical pilot composition v1"
}
