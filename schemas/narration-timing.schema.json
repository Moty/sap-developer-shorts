{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "local-preview"
    },
    "voice": {
      "type": "string",
      "minLength": 1
    },
    "rate": {
      "type": "integer",
      "minimum": 120,
      "maximum": 220
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sampleRate": {
      "const": 22050
    },
    "scenes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0
          },
          "speechSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["id", "startSeconds", "endSeconds", "speechSeconds"]
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "spokenText": {
            "type": "string",
            "minLength": 1
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0
          },
          "speakerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "speakerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "required": ["sceneId", "text", "spokenText", "startSeconds", "endSeconds"],
        "dependencies": {
          "speakerId": ["speakerName"],
          "speakerName": ["speakerId"]
        }
      }
    },
    "engine": {
      "const": "kokoro"
    },
    "speed": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.2
    },
    "alignment": {
      "const": "model-estimated-phrase-boundaries"
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "voice",
    "rate",
    "durationSeconds",
    "sampleRate",
    "scenes",
    "cues"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "dependencies": {
    "engine": ["speed", "alignment"],
    "alignment": ["engine", "speed"],
    "speed": ["engine", "alignment"]
  }
}
