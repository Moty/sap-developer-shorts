{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^NEWS-[0-9]{2}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "event": {
        "type": "string",
        "minLength": 1
      },
      "angle": {
        "type": "string",
        "minLength": 1
      },
      "priority": {
        "type": "integer",
        "minimum": 1
      },
      "status": {
        "enum": ["draft-ready", "needs-research"]
      },
      "sourceUrls": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "required": ["id", "title", "event", "angle", "priority", "status", "sourceUrls"]
  },
  "minItems": 1
}
