{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "demoId": {
      "const": "cap-inventory"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+(?:[-+].+)?$"
        },
        "cds": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$"
        },
        "database": {
          "const": "sqlite-memory"
        }
      },
      "required": ["node", "cds", "database"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "captures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "products": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "@odata.context": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ID": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stock": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": ["ID", "title", "stock"]
              }
            }
          },
          "required": ["value"]
        },
        "filtered": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "@odata.context": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ID": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stock": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": ["ID", "title", "stock"]
              }
            }
          },
          "required": ["value"]
        },
        "metadata": {
          "type": "string",
          "minLength": 1,
          "pattern": "<edmx:Edmx\\b"
        }
      },
      "required": ["products", "filtered", "metadata"]
    }
  },
  "required": ["demoId", "verifiedAt", "environment", "checks", "captures"],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Live CAP demo evidence v1"
}
