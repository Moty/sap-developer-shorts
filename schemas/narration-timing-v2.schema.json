{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "mode": {
      "const": "local-preview"
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sampleRate": {
      "const": 22050
    },
    "scenes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0
          },
          "speechSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["id", "startSeconds", "endSeconds", "speechSeconds"]
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "spokenText": {
            "type": "string",
            "minLength": 1
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0
          },
          "speakerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "speakerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "required": ["sceneId", "text", "spokenText", "startSeconds", "endSeconds"],
        "dependencies": {
          "speakerId": ["speakerName"],
          "speakerName": ["speakerId"]
        }
      }
    },
    "engine": {
      "const": "local-voices"
    },
    "alignment": {
      "const": "local-per-speaker-phrase-boundaries"
    },
    "alignmentRuntimeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "engine": {
            "enum": ["qwen", "kokoro"]
          },
          "voiceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["id", "engine", "voiceHash"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "durationSeconds",
    "sampleRate",
    "scenes",
    "cues",
    "engine",
    "alignment",
    "alignmentRuntimeHash",
    "speakers"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sap-developer-shorts.local/schemas/narration-timing-v2.schema.json"
}
