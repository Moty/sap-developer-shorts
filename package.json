{
  "name": "sap-developer-shorts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verified episode preparation for SAP Developer Shorts",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "demos/cap/inventory"
  ],
  "scripts": {
    "shorts": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "validate": "tsx src/cli.ts validate",
    "pilot": "tsx src/cli.ts preview CAP-01",
    "demo": "npm start --workspace @sap-shorts/cap-inventory",
    "test:demo": "npm test --workspace @sap-shorts/cap-inventory",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:demo && npm run validate",
    "mac:setup": "tsx src/cli.ts mac-setup",
    "firebase:export": "tsx src/cli.ts firebase-export",
    "firebase:worker": "tsx src/cli.ts firebase-worker",
    "firebase:sync": "tsx src/cli.ts firebase-sync",
    "firebase:deploy": "npm run firebase:export && npx firebase deploy",
    "private:build": "tsx scripts/private/build.ts",
    "private:serve": "tsx src/cloud/server.ts",
    "private:emulators": "firebase emulators:start --config firebase.private.json --project demo-sap-shorts-private --only auth,firestore,storage",
    "worker:register": "tsx src/worker/cli.ts register",
    "worker:start": "tsx src/worker/cli.ts start",
    "worker:status": "tsx src/worker/cli.ts status",
    "worker:capabilities": "tsx src/worker/cli.ts capabilities",
    "worker:unregister": "tsx src/worker/cli.ts unregister",
    "private:runtime-package": "tsx scripts/private/runtime-manifest.ts",
    "private:dispatch": "tsx scripts/private/dispatch.ts",
    "private:test:integration": "tsx scripts/private/integration.ts && tsx scripts/private/rules-test.ts",
    "private:test:render": "tsx scripts/private/render-smoke.ts",
    "private:test:voice": "tsx scripts/private/voice-smoke.ts",
    "private:test:library": "tsx scripts/private/library-smoke.ts"
  },
  "dependencies": {
    "@firebase/app": "0.14.3",
    "@firebase/auth": "1.11.0",
    "@google-cloud/run": "4.2.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@napi-rs/canvas": "1.0.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.3",
    "firebase-admin": "13.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "firebase-admin": {
      "@firebase/database-compat": "2.0.11"
    },
    "uuid": "11.1.1"
  }
}
